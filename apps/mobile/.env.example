# Mobile App Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
# Include /api/v1 because mobile services call endpoints like /auth/login
EXPO_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Razorpay public key (never put the key secret in the mobile app)
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_public_key"

# Environment
NODE_ENV="development"

# App Configuration
EXPO_PUBLIC_APP_NAME="Pinak Mobile"