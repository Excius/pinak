# API Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV="development"
LOG_LEVEL="debug"

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/pinak"

# Security
JWT_SECRET="your-jwt-secret-here"
ACCESS_TOKEN_EXPIRY="900000" # 15 minutes in milliseconds
REFRESH_TOKEN_EXPIRY="2592000000" # 30 days in milliseconds
FORGOT_PASSWORD_EXPIRY_MINUTES="15" # 15 minutes
EMAIL_VERIFICATION_EXPIRY_HOURS="24" # 24 hours

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES="15" # window duration in minutes
RATE_LIMIT_MAX="600" # max requests per window for general routes
AUTH_RATE_LIMIT_MAX="5000" # max requests per window for auth routes

# Email Configuration
MAIL_FROM=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true" # true for 465, false for other ports

# URLs
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"
MOBILE_APP_URL="pinak://oauth/callback"

# Google OAuth
CLIENT_ID_WEB="your-google-client-id.apps.googleusercontent.com"
CLIENT_SECRET="your-google-client-secret"
REDIRECT_URI_WEB="http://localhost:5173/oauth/callback"
REDIRECT_URI_BACKEND="http://localhost:3001/api/v1/auth/google/mobile/callback"
REDIRECT_URI_MOBILE="pinak://oauth/callback"