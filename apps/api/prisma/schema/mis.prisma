model InventoryReservation {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String?
  comboKitId       String?
  quantity         Int

  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  expiresAt DateTime

  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  comboKit       ComboKit?       @relation(fields: [comboKitId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productVariantId])
  @@index([comboKitId])
  @@index([status])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
}

model AuditLog {
  id        String  @id @default(cuid())
  entity    String // e.g., "Product", "Order", "User"
  entityId  String
  action    String // e.g., "CREATE", "UPDATE", "DELETE"
  before    Json?
  after     Json?
  actorId   String? // user/admin/system that performed the action
  actorRole String? // e.g., "USER", "ADMIN", "SYSTEM"

  source String? // e.g., "API", "Admin Panel", "System", "Webhook", "cron", etc.

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
}
