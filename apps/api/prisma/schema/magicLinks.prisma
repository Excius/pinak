model MagicLink {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique
  type      MagicLinkType

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MagicLinkType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
