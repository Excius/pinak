model Article {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String
  type        ContentType
  author      String
  publishedAt DateTime?
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)
}

enum ContentType {
  BLOG
  NEWS
  TUTORIAL
}

model DynamicAsset {
  id          String    @id @default(cuid())
  slug        String    @unique // The "name-id" devices use to fetch the asset (e.g. "mobile-home-banner-top")
  url         String    // The S3 public URL
  s3Key       String?   // The S3 object key for lifecycle management (delete/replace)
  type        AssetType @default(IMAGE)
  title       String?   // Optional descriptive title for admin panel
  description String?   // Optional admin notes
  metadata    Json?     // Optional JSON payload for the device (e.g. link URL, dimensions, etc.)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, isActive, isDeleted])
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique // e.g. "privacy-policy", "terms-and-conditions", "about-us"
  title           String   // e.g. "Privacy Policy"
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, isActive, isDeleted])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  group       String   @default("GENERAL") // "CONTACT", "WHATSAPP", "GENERAL"
  description String?
  isPublic    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key, isPublic])
  @@index([group])
}
