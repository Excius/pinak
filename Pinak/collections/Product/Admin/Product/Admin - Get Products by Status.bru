meta {
  name: Admin - Get Products by Status
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/products/admin/status/{{status}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  sortBy: createdAt
  sortOrder: desc
  search: serum
  brand: your-brand
  isActive: true
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  status: ACTIVE
}

docs {
  Route uses :status path + ProductTypes.GetAllProductsAdmin query schema
  Params: status
  Query: page, limit, sortBy, sortOrder, search, brand, isActive
  Body: none
}
