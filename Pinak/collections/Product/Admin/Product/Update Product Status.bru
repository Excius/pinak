meta {
  name: Update Product Status
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/products/admin/{{id}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "isActive": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  id: your-product-id-here
}

docs {
  Schema: ProductTypes.UpdateProductStatus
  Params: id
  Query: none
  Body: isActive
}
