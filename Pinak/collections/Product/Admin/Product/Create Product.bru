meta {
  name: Create Product
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/products/admin
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Hydrating Serum",
    "slug": "hydrating-serum",
    "description": "Deep hydration with hyaluronic acid",
    "keyIngredients": "Hyaluronic Acid, Panthenol",
    "metaTitle": "Hydrating Serum",
    "metaDescription": "Daily hydrating facial serum",
    "metaKeywords": "serum, hydration",
    "seoKeyword": "hydrating-serum",
    "model": "HS-100",
    "ean": "1234567890123",
    "frontImageUrl": "https://example.com/images/hydrating-serum.jpg",
    "tags": ["hydration", "vegan"],
    "brandId": "your-brand-id",
    "requiresShipping": true,
    "outOfStockStatus": "BACKORDER",
    "dimensionLength": 12,
    "dimensionWidth": 4,
    "dimensionHeight": 4,
    "lengthClassId": "your-length-class-id",
    "weightGrams": 120,
    "weightClassId": "your-weight-class-id",
    "taxClassId": "your-tax-class-id",
    "sortOrder": 0,
    "isActive": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: ProductTypes.CreateProduct
  Params: none
  Query: none
  Body: name(required), slug, description, keyIngredients, metaTitle, metaDescription, metaKeywords, seoKeyword, model, ean, frontImageUrl, tags, brandId, requiresShipping, outOfStockStatus, dimensionLength, dimensionWidth, dimensionHeight, lengthClassId, weightGrams, weightClassId, taxClassId, sortOrder, isActive
}
