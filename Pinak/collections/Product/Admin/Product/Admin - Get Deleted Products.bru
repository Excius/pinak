meta {
  name: Admin - Get Deleted Products
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/products/admin/deleted
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  sortBy: createdAt
  sortOrder: desc
  search: serum
  brand: your-brand
  isActive: false
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: ProductTypes.GetAllProductsAdmin
  Params: none
  Query: page, limit, sortBy, sortOrder, search, brand, isActive
  Body: none
}
