meta {
  name: Hard Delete Product (Admin Only)
  type: http
  seq: 32
}

delete {
  url: {{baseUrl}}/api/v1/products/admin/{{productId}}/hard
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-admin-jwt-token-here
  productId: your-product-id-here
}

docs {
  Permanently delete a product and all its variants/images.

  Requires: Admin role only

  WARNING: This action cannot be undone!

  Path Parameters:
  - id: Product ID
}