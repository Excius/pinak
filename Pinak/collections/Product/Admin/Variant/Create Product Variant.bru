meta {
  name: Create Product Variant
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/variants
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "sku": "SERUM-30ML",
    "ean": "1234567890124",
    "price": 799,
    "comparePrice": 999,
    "stock": 25,
    "weightGrams": 120,
    "weightClassId": "your-weight-class-id",
    "tags": ["30ml"],
    "optionValueIds": ["option-value-id-1", "option-value-id-2"],
    "isActive": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  productId: your-product-id-here
}

docs {
  Schema: ProductTypes.CreateProductVariant
  Params: productId
  Query: none
  Body: sku(required), ean, price, comparePrice, stock, weightGrams, weightClassId, tags, optionValueIds, isActive
}
