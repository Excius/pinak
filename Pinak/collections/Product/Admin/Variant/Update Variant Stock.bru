meta {
  name: Update Variant Stock
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/v1/products/admin/variants/{{variantId}}/stock
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "newStock": 100
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Schema: ProductTypes.UpdateVariantStock
  Params: variantId
  Query: none
  Body: newStock
}
