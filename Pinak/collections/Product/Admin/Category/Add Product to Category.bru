meta {
  name: Add Product to Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/admin/{{productId}}/categories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "categoryId": "your-category-id-here"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  productId: your-product-id-here
}

docs {
  Schema: ProductCategoryTypes.AddProductToCategory
  Params: productId
  Query: none
  Body: categoryId
}
