meta {
  name: Remove Product from Category
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/products/{{productId}}/categories/{{categoryId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  productId: your-product-id-here
  categoryId: your-category-id-here
}

docs {
  Schema: ProductCategoryTypes.RemoveProductFromCategory
  Params: productId, categoryId
  Query: none
  Body: {}
}
