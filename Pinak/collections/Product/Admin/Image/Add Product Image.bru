meta {
  name: Add Product Image
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/products/admin/variants/{{variantId}}/images
  body: multipartForm
  auth: inherit
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  image: @file(/home/excius/Downloads/profile_6e4fa855-634a-4ab8-a9e9-2532e72c795e_1766677108378.jpg) @contentType(image/jpeg)
  altText: Test Image @contentType(text/plain)
  isPrimary: false @contentType(text/plain)
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  variantId: cmnj36trl00412amzrokgnkoy
}

docs {
  Schema: ProductTypes.AddProductImage
  Params: variantId
  Query: none
  Body: url(required), altText
}
