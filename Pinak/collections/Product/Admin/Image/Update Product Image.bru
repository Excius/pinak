meta {
  name: Update Product Image
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/products/admin/images/{{imageId}}
  body: multipartForm
  auth: inherit
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {}
}

body:multipart-form {
  image: @file(/home/excius/Downloads/profile_6e4fa855-634a-4ab8-a9e9-2532e72c795e_1766677108378.jpg) @contentType(image/jpeg)
  altText: Test Update Image @contentType(text/plain)
  isPrimary: false @contentType(text/plain)
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  imageId: cmnjeljbv00007nmz2hmm7ee6
}

docs {
  Schema: ProductTypes.SetPrimaryImage
