meta {
  name: Hard Delete Image (Admin Only)
  type: http
  seq: 34
}

delete {
  url: {{baseUrl}}/api/v1/products/admin/images/{{imageId}}/hard
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-admin-jwt-token-here
  imageId: your-image-id-here
}

docs {
  Permanently delete a product image.

  Requires: Admin role only

  WARNING: This action cannot be undone!

  Path Parameters:
  - id: Image ID
}