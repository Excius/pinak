meta {
  name: Remove Related Product
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/products/admin/{{productId}}/related/{{relatedProductId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  productId: your-product-id-here
  relatedProductId: your-related-product-id-here
}

docs {
  Schema: RelatedProductTypes.RemoveRelatedProduct
  Params: productId, relatedProductId
  Query: none
  Body: {}
}
