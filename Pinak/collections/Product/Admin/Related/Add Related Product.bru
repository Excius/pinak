meta {
  name: Add Related Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/related
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "relatedProductId": "your-related-product-id-here",
    "sortOrder": 1
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  productId: your-product-id-here
}

docs {
  Schema: RelatedProductTypes.AddRelatedProduct
  Params: productId
  Query: none
  Body: relatedProductId, sortOrder(optional)
}
