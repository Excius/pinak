meta {
  name: Create Product
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Nike Air Max 90",
    "description": "Classic Nike Air Max 90 sneakers with visible air cushioning",
    "brand": "Nike",
    "categoryId": "your-category-id-here",
    "isActive": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a new product.

  Requires: Moderator or Admin role

  Body Parameters:
  - name: Product name (required, 1-255 chars)
  - slug: URL slug (optional, auto-generated if not provided)
  - description: Product description (optional)
  - brand: Product brand (optional)
  - categoryId: Category ID (required)
  - isActive: Active status (default: true)
}