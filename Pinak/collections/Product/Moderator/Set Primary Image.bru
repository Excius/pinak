meta {
  name: Set Primary Image
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/v1/products/images/{{imageId}}/primary
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "isPrimary": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  imageId: your-image-id-here
}

docs {
  Set an image as the primary image for its variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - imageId: Image ID

  Body Parameters:
  - isPrimary: Boolean flag (true to set as primary)
}