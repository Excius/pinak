meta {
  name: Get Tax Class by ID
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/api/v1/tax-classes/{{taxClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  taxClassId: your-taxclass-id-here
  authToken: your-jwt-token-here
}

docs {
  Get a tax class by ID (authenticated).
}