meta {
  name: Get Filter Group by ID
  type: http
  seq: 41
}

get {
  url: {{baseUrl}}/api/v1/filters/groups/{{groupId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  groupId: your-group-id-here
  authToken: your-jwt-token-here
}

docs {
  Get a filter group by ID (authenticated).
}