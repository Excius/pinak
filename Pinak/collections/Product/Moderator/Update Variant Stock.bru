meta {
  name: Update Variant Stock
  type: http
  seq: 30
}

patch {
  url: {{baseUrl}}/api/v1/products/variants/{{variantId}}/stock
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "newStock": 25
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Update the stock quantity for a specific variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - variantId: Product variant ID

  Body Parameters:
  - newStock: New stock quantity (integer)
}