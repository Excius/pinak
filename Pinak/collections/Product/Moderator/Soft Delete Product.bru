meta {
  name: Soft Delete Product
  type: http
  seq: 20
}

delete {
  url: {{baseUrl}}/api/v1/products/{{productId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  productId: your-product-id-here
}

docs {
  Soft delete a product (marks as deleted, can be restored).

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Product ID
}