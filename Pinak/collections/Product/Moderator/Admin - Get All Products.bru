meta {
  name: Admin - Get All Products
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/products/admin/all?page=1&limit=10&search={{searchQuery}}&brand={{brand}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  search: sunscreen
  brand: nivea
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  searchQuery: sunscreen
  brand: nivea
}

docs {
  Admin endpoint to get all products including deleted ones.

  Requires: Moderator or Admin role

  Query Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 100)
  - search: Full-text search across name/description/tags
  - brand: Filter by brand slug or name
}