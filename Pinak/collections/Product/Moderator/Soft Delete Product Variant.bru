meta {
  name: Soft Delete Product Variant
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/api/v1/products/variants/{{variantId}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Soft delete a product variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Variant ID
}