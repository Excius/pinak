meta {
  name: Get Out of Stock Products
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/api/v1/products/admin/stock/out-of-stock
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Get all products that are out of stock (stock = 0).

  Requires: Moderator or Admin role
}