meta {
  name: Update Product Status
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/products/{{productId}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "isActive": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  productId: your-product-id-here
}

docs {
  Update a product's active status.

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Product ID

  Body Parameters:
  - isActive: Boolean status (true/false)
}