meta {
  name: Create Category
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Suncare",
    "slug": "suncare",
    "parentId": ""
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a new category. Requires Moderator or Admin role.

  Body:
  - name (required)
  - slug (optional)
  - parentId (optional)
}