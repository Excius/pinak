meta {
  name: Update Product Variant
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/api/v1/products/variants/{{variantId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "sku": "NAM90-BLK-42-UPDATED",
    "shade": "Black",
    "size": "42",
    "price": 139.99,
    "stock": 75
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Update an existing product variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Variant ID

  Body Parameters (all optional):
  - sku: Stock Keeping Unit (1-100 chars, must be unique)
  - shade: Color/shade
  - size: Size specification
  - price: Price (positive number)
  - stock: Stock quantity (non-negative)
}