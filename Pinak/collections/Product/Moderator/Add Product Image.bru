meta {
  name: Add Product Image
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/products/variants/{{variantId}}/images
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "url": "https://example.com/images/nike-air-max-90-black.jpg",
    "altText": "Nike Air Max 90 Black Sneakers"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Add an image to a product variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - variantId: Product variant ID

  Body Parameters:
  - url: Image URL (required, must be valid URL)
  - altText: Alt text for accessibility (optional)
}