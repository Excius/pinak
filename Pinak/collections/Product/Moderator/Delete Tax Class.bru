meta {
  name: Delete Tax Class
  type: http
  seq: 62
}

delete {
  url: {{baseUrl}}/api/v1/tax-classes/{{taxClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  taxClassId: your-taxclass-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a tax class (Moderator/Admin required).
}