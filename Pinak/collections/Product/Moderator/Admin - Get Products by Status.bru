meta {
  name: Admin - Get Products by Status
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/products/admin/status/{{status}}?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  status: ACTIVE
}

docs {
  Admin endpoint to get products filtered by status.

  Requires: Moderator or Admin role

  Path Parameters:
  - status: Product status (ACTIVE/INACTIVE)

  Query Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 100)
}