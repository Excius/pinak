meta {
  name: List Related Products
  type: http
  seq: 77
}

get {
  url: {{baseUrl}}/api/v1/related-products/{{productId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  authToken: your-jwt-token-here
}

docs {
  List related products for a product (authenticated).
}