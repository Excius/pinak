meta {
  name: Delete Category
  type: http
  seq: 33
}

delete {
  url: {{baseUrl}}/api/v1/categories/{{categoryId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  categoryId: your-category-id-here
}

docs {
  Delete a category. Deletion is rejected if products or child categories exist.
  Requires Moderator or Admin role.
}