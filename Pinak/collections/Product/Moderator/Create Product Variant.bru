meta {
  name: Create Product Variant
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/variants
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "sku": "NAM90-BLK-42",
    "shade": "Black",
    "size": "42",
    "price": 129.99,
    "stock": 50
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  productId: your-product-id-here
}

docs {
  Create a new variant for a product.

  Requires: Moderator or Admin role

  Path Parameters:
  - productId: Product ID

  Body Parameters:
  - sku: Stock Keeping Unit (required, 1-100 chars, unique)
  - shade: Color/shade (optional)
  - size: Size specification (optional)
  - price: Price (required, positive number)
  - stock: Stock quantity (default: 0)
}