meta {
  name: Admin - Get Deleted Products
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/products/admin/deleted?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Admin endpoint to get all soft-deleted products.

  Requires: Moderator or Admin role

  Query Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 100)
}