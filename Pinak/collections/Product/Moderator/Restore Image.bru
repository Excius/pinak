meta {
  name: Restore Image
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/v1/products/images/{{imageId}}/restore
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  imageId: your-image-id-here
}

docs {
  Restore a soft-deleted product image.

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Image ID
}