meta {
  name: Update Category
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/v1/categories/{{categoryId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Suncare & Protection",
    "slug": "suncare-protection",
    "parentId": null
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  categoryId: your-category-id-here
}

docs {
  Update an existing category. `parentId` can be set to `null` to unset parent.
  Requires Moderator or Admin role.
}