meta {
  name: Add Product to Category
  type: http
  seq: 73
}

post {
  url: {{baseUrl}}/api/v1/product-categories/{{productId}}
  body: json
  auth: inherit
}

body:json {
  {
    "categoryId": "{{categoryId}}"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  categoryId: your-category-id-here
  authToken: your-jwt-token-here
}

docs {
  Attach a product to a category (Moderator/Admin required).
}