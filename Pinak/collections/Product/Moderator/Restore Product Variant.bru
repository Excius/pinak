meta {
  name: Restore Product Variant
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/api/v1/products/variants/{{variantId}}/restore
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  variantId: your-variant-id-here
}

docs {
  Restore a soft-deleted product variant.

  Requires: Moderator or Admin role

  Path Parameters:
  - id: Variant ID
}