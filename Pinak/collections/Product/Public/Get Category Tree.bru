meta {
  name: Get Category Tree
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/categories/tree
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Returns the full nested category tree (root nodes with nested `children`).
}