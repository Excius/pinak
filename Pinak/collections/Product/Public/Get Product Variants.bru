meta {
  name: Get Product Variants
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/variants
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
}

docs {
  Get all variants for a specific product.

  Path Parameters:
  - productId: Product ID
}