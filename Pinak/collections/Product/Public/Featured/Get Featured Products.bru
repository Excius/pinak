meta {
  name: Get Featured Products
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/products/featured
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  sectionId: optional-section-id
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: ProductTypes.GetFeaturedProducts
  Params: none
  Query: page, limit, sectionId
  Body: none
}
