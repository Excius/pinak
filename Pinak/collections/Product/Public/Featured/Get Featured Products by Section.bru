meta {
  name: Get Featured Products by Section
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/products/featured/section/{{sectionId}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  sectionId: your-featured-section-id
}

docs {
  Route: /products/featured/section/:sectionId (query validated by ProductTypes.GetFeaturedProducts)
  Params: sectionId
  Query: page, limit
  Body: none
}
