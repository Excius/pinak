meta {
  name: Get Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products?page=1&limit=10&sortBy=createdAt&sortOrder=desc
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  sortBy: createdAt
  sortOrder: desc
  ~search: serum
  ~categoryId: your-category-id
  ~isActive: true
  ~minPrice: 0
  ~maxPrice: 5000
  ~brand: your-brand-slug-or-name
  ~inStock: true
  ~tags: clean,vegan
  ~filterValueIds: value-id-1,value-id-2
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: ProductTypes.GetProducts
  Params: none
  Query: page, limit, sortBy, sortOrder, search, categoryId, isActive, minPrice, maxPrice, brand, inStock, tags, filterValueIds
  Body: none
}
