meta {
  name: Get Products by Category
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/products/category/{{categoryId}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  sortBy: createdAt
  sortOrder: desc
  brand: your-brand-slug-or-name
  inStock: true
  filterValueIds: value-id-1,value-id-2
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  categoryId: your-category-id-here
}

docs {
  Schema: ProductTypes.GetProductsWithCategory
  Params: categoryId
  Query: page, limit, sortBy, sortOrder, brand, inStock, filterValueIds
  Body: none
}
