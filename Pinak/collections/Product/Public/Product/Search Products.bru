meta {
  name: Search Products
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/products/search
  body: none
  auth: inherit
}

params:query {
  q: niacinamide
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: ProductTypes.SearchProducts
  Params: none
  Query: q, page, limit
  Body: none
}
