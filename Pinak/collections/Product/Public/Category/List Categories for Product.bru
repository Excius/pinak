meta {
  name: List Categories for Product
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/categories
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  productId: your-product-id-here
}

docs {
  Schema: ProductCategoryTypes.ListCategoriesForProduct
  Params: productId
  Query: none
  Body: none
}
