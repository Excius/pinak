meta {
  name: Get Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products?page=1&limit=1&inStock=true
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 1
  inStock: true
  ~filterValueIds: color-filter-id,size-filter-id
  ~brand: nike
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  filterValueIds: color-filter-id,size-filter-id
  brand: nike
  inStock: true
}

docs {
  Get a paginated list of products with optional filters.
  
  Query Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 100)
  - sortBy: Field to sort by
  - sortOrder: Sort order (asc/desc)
  - search: Search term
  - categoryId: Filter by category
  - isActive: Filter by active status
  - minPrice: Minimum price filter
  - maxPrice: Maximum price filter
  - brand: Filter by brand
  - inStock: Filter by stock availability
  - filterValueIds: Comma-separated list of filter value IDs (AND across values)
}
