meta {
  name: Get Category by ID
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/categories/{{categoryId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  categoryId: your-category-id-here
}

docs {
  Fetch a category by its ID.

  Path Parameters:
  - categoryId: Category ID (required)
}