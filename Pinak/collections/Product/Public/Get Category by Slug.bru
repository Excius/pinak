meta {
  name: Get Category by Slug
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/categories/slug/{{slug}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  slug: electronics
}

docs {
  Fetch a category by its SEO slug.

  Path Parameters:
  - slug: category slug (required)
}