meta {
  name: Get Product with Details
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/details
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
}

docs {
  Get a product with full details including category and variant information.

  Path Parameters:
  - id: Product ID
}