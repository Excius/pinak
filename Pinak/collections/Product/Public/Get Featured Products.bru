meta {
  name: Get Featured Products
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/products/featured?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Get featured products.
  
  Query Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10, max: 100)
  - sectionId: Optional section ID to filter featured products
}
