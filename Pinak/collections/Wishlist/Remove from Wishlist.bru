meta {
  name: Remove from Wishlist
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/wishlist/items/{{itemId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  itemId: your-wishlist-item-id-here
  authToken: your-jwt-token-here
}

docs {
  Remove an item from authenticated user's wishlist.
}
