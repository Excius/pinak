meta {
  name: Clear Wishlist
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/wishlist
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Remove all items from authenticated user's wishlist.
}
