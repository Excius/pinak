meta {
  name: Add to Wishlist
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/wishlist/items
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "productVariantId": "cmnj36r8v003r2amzrpm0qvrx"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Add a product variant to the authenticated user's own wishlist.
}
