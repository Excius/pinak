meta {
  name: Get Wishlist
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/wishlist
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Get only the authenticated user's wishlist (never global wishlist data).
}
