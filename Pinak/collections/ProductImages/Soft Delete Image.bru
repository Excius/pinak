meta {
  name: Soft Delete Image
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/images/{{imageId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  imageId: your-image-id-here
  authToken: your-jwt-token-here
}

docs {
  Soft delete a product image (Moderator/Admin required).
}