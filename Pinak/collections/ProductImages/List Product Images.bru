meta {
  name: List Product Images
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/images
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
}

docs {
  List images for a product (public).
}