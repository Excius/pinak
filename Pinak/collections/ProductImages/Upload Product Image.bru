meta {
  name: Upload Product Image
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/variants/{{variantId}}/images
  body: json
  auth: inherit
}

body:json {
  {
    "url": "https://example.com/image.jpg",
    "altText": "Sample image",
    "isPrimary": true
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  variantId: your-variant-id-here
  authToken: your-jwt-token-here
}

docs {
  Upload/add an image for a product variant (Moderator/Admin required).
}