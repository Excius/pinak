meta {
  name: Restore Image
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/images/{{imageId}}/restore
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  imageId: your-image-id-here
  authToken: your-jwt-token-here
}

docs {
  Restore a soft-deleted product image (Moderator/Admin required).
}