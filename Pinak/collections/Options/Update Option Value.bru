meta {
  name: Update Option Value
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/options/values/{{valueId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "value": "50ml",
    "sortOrder": 1
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  valueId: your-option-value-id-here
  authToken: your-jwt-token-here
}

docs {
  Update an option value (Moderator/Admin required).
}