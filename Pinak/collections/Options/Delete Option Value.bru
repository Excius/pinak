meta {
  name: Delete Option Value
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/options/values/{{valueId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  valueId: your-option-value-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete an option value (Moderator/Admin required).
}