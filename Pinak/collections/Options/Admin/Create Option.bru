meta {
  name: Create Option
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/options
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Volume",
    "sortOrder": 0
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create an option group (Moderator/Admin required).
}