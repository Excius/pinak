meta {
  name: Admin - List Options
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/options/admin
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  List option definitions with full admin payloads. Requires Moderator or Admin.
}
