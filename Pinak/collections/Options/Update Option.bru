meta {
  name: Update Option
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/options/{{optionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Volume (ml)",
    "sortOrder": 1
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  optionId: your-option-id-here
  authToken: your-jwt-token-here
}

docs {
  Update an option group (Moderator/Admin required).
}