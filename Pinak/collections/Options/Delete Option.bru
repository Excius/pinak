meta {
  name: Delete Option
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/options/{{optionId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  optionId: your-option-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete an option group (Moderator/Admin required).
}