meta {
  name: Create Product Variant
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/variants
  body: json
  auth: inherit
}

body:json {
  {
    "sku": "NEW-SKU-001",
    "price": 1000,
    "stock": 10,
    "tags": ["test"]
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  authToken: your-jwt-token-here
}

docs {
  Create a new variant for an existing product (Moderator/Admin required).
}