meta {
  name: Soft Delete Product Variant
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/variants/{{variantId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  variantId: your-variant-id-here
  authToken: your-jwt-token-here
}

docs {
  Soft delete a product variant (Moderator/Admin required).
}