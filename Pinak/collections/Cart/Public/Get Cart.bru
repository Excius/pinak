meta {
  name: Get Cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/cart
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: CartTypes.GetCart
  Requires authenticated user.
}
