meta {
  name: Update Cart Item Quantity
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/cart/items/{{itemId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "quantity": 2
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  itemId: cmoadeytg0001bmmz9li2nou2
}

docs {
  Schema: CartTypes.UpdateCartItem
}
