meta {
  name: Add Item to Cart
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/cart/items
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "productVariantId": "cmnj36trl00412amzrokgnkoy",
    "quantity": 1
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: CartTypes.AddToCart
  Provide exactly one: productVariantId or comboKitId.
}
