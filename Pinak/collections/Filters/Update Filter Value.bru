meta {
  name: Update Filter Value
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/filters/values/{{valueId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Crimson",
    "slug": "crimson",
    "sortOrder": 1
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  valueId: your-filter-value-id-here
  authToken: your-jwt-token-here
}

docs {
  Update a filter value (Moderator/Admin required).
}