meta {
  name: Create Filter Value
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/filters/groups/{{groupId}}/values
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Red",
    "slug": "red",
    "sortOrder": 0
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  groupId: your-group-id-here
  authToken: your-jwt-token-here
}

docs {
  Create a filter value (Moderator/Admin required).
}