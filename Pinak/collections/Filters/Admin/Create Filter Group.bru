meta {
  name: Create Filter Group
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/filters/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Color",
    "slug": "color",
    "sortOrder": 0,
    "isActive": true
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a filter group (Moderator/Admin required).
}