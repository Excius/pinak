meta {
  name: Delete Filter Group
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/filters/groups/{{groupId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  groupId: your-group-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a filter group (Moderator/Admin required).
}