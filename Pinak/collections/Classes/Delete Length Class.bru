meta {
  name: Delete Length Class
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/length-classes/{{lengthClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  lengthClassId: your-length-class-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a length class (Moderator/Admin required).
}