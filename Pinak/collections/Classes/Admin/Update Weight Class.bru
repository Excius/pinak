meta {
  name: Update Weight Class
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/v1/weight-classes/{{weightClassId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Gram Updated",
    "unit": "g"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  weightClassId: your-weight-class-id-here
  authToken: your-jwt-token-here
}

docs {
  Update a weight class (Moderator/Admin required).
}