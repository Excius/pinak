meta {
  name: Create Weight Class
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/weight-classes
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Gram",
    "unit": "g"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a weight class (Moderator/Admin required).
}