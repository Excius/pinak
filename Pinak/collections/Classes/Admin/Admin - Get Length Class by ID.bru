meta {
  name: Admin - Get Length Class by ID
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/admin/length-classes/{{lengthClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  lengthClassId: your-length-class-id-here
  authToken: your-jwt-token-here
}

docs {
  Get a length class by ID with full admin payloads. Requires Moderator or Admin.
}
