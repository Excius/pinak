meta {
  name: Delete Weight Class
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/v1/weight-classes/{{weightClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  weightClassId: your-weight-class-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a weight class (Moderator/Admin required).
}