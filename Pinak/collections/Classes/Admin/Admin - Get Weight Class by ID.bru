meta {
  name: Admin - Get Weight Class by ID
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/weight-classes/{{weightClassId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  weightClassId: your-weight-class-id-here
  authToken: your-jwt-token-here
}

docs {
  Get a weight class by ID with full admin payloads. Requires Moderator or Admin.
}
