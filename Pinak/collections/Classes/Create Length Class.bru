meta {
  name: Create Length Class
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/length-classes
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Centimeter",
    "unit": "cm"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a length class (Moderator/Admin required).
}