meta {
  name: Remove Product from Category
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/products/{{productId}}/categories/{{categoryId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  categoryId: your-category-id-here
  authToken: your-jwt-token-here
}

docs {
  Remove a product from a category (Moderator/Admin required).
}