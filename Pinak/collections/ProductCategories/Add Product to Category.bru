meta {
  name: Add Product to Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "categoryId": "your-category-id-here"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  authToken: your-jwt-token-here
}

docs {
  Add an existing product to a category (Moderator/Admin required).
}