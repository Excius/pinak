meta {
  name: Update Combo Kit Item
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/v1/combo-kits/{{comboKitId}}/items/{{itemId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "quantity": 2,
    "sortOrder": 1,
    "originalPrice": 2500,
    "discountedPrice": 2200,
    "isRequired": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  comboKitId: combo-kit-id-here
  itemId: combo-kit-item-id-here
}

docs {
  Update a combo item in-place. Requires Moderator or Admin.
}
