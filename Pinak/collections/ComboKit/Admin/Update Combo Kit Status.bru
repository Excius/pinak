meta {
  name: Update Combo Kit Status
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/combo-kits/{{id}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "isActive": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Update combo kit active status. Requires Moderator or Admin.
}
