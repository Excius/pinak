meta {
  name: Reorder Combo Kit Items
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/combo-kits/{{comboKitId}}/items/reorder
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "items": [
      { "id": "item-id-1", "sortOrder": 0 },
      { "id": "item-id-2", "sortOrder": 1 },
      { "id": "item-id-3", "sortOrder": 2 }
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  comboKitId: combo-kit-id-here
}

docs {
  Reorder combo items by explicit sortOrder list. Requires Moderator or Admin.
}
