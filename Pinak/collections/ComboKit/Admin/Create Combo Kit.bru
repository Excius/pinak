meta {
  name: Create Combo Kit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/combo-kits
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Weekend Essentials Pack",
    "slug": "weekend-essentials-pack",
    "description": "A curated pack for weekend wear",
    "audience": "unisex",
    "metaTitle": "Weekend Essentials Pack | Pinak",
    "metaDescription": "Curated kit for weekend-ready looks.",
    "metaKeywords": "weekend makeup, combo kit, curated pack",
    "seoKeyword": "weekend-essentials-pack",
    "imageUrl": "https://example.com/images/combo-weekend-essentials-pack.jpg",
    "pricingStrategy": "FIXED_PRICE",
    "discountType": "PERCENTAGE",
    "discountValue": 10,
    "tags": ["weekend", "makeup", "combo"],
    "sortOrder": 1,
    "price": 4999,
    "isActive": true,
    "items": [
      {
        "productVariantId": "variant-id-1",
        "quantity": 1,
        "sortOrder": 0,
        "originalPrice": 2999,
        "discountedPrice": 2799,
        "isRequired": true
      },
      {
        "productVariantId": "variant-id-2",
        "quantity": 2,
        "sortOrder": 1,
        "originalPrice": 1500,
        "discountedPrice": 1350,
        "isRequired": false
      }
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Create a new combo kit. Requires Moderator or Admin role.

  Supports production combo fields:
  - SEO metadata, imageUrl
  - pricingStrategy, discountType, discountValue
  - tags, sortOrder
  - rich item payload (sortOrder, originalPrice, discountedPrice, isRequired)
}
