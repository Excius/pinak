meta {
  name: Update Combo Kit Pricing
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/combo-kits/{{id}}/pricing
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "pricingStrategy": "FIXED_PRICE",
    "price": 4999,
    "discountType": "PERCENTAGE",
    "discountValue": 12
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Update combo pricing model and discount settings. Requires Moderator or Admin.
}
