meta {
  name: Hard Delete Combo Kit (Admin only)
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/combo-kits/admin/{{id}}/hard
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Permanently delete a combo kit (admin only). Make sure there are no dependent resources (carts/orders).
}
