meta {
  name: Remove Combo Kit Item
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/combo-kits/{{comboKitId}}/items/{{itemId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  comboKitId: combo-kit-id-here
  itemId: combo-kit-item-id-here
}

docs {
  Remove an item from a combo kit. Requires Moderator or Admin.
}
