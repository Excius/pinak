meta {
  name: Get Combo Kit by Slug
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/combo-kits/slug/{{slug}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  slug: lash-define-duo
}

docs {
  Get a combo kit by its slug (public).
  Replace `{{slug}}` with the combo kit slug to fetch.
}
