meta {
  name: Get Combo Kits
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/combo-kits?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}
headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Fetch paginated combo kits (public).

  Query params:
  - page (default 1)
  - limit (default 10)
  - isActive (optional)
}
