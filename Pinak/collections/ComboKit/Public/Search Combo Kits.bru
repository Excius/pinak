}

params:query {
  q: glow
  page: 1
  limit: 10
  isActive: true
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Search combo kits using query term `q`.
}
