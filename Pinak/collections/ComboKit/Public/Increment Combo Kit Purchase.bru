meta {
  name: Increment Combo Kit Purchase
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/combo-kits/{{id}}/increment-purchase
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "quantity": 1
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Increment combo kit purchased count (authenticated route).
}
