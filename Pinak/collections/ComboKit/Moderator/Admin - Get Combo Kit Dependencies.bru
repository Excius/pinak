meta {
  name: Admin - Get Combo Kit Dependencies
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/combo-kits/admin/{{id}}/dependencies
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Get combo dependency counts (carts/orders) before hard delete. Requires Moderator or Admin.
}
