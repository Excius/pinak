meta {
  name: Soft Delete Combo Kit
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/combo-kits/{{id}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Soft-delete a combo kit (mark as deleted). Requires Moderator or Admin.
}
