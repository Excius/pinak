meta {
  name: Admin - Get All Combo Kits
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/combo-kits/admin/all?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  ~search: starter
  ~sortBy: createdAt
  ~sortOrder: desc
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  List all combo kits including deleted records. Requires Moderator or Admin.
}
