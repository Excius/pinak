meta {
  name: Admin - Get Combo Kit Analytics
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/combo-kits/admin/{{id}}/analytics
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Get combo analytics (views, purchases, order/cart aggregates). Requires Moderator or Admin.
}
