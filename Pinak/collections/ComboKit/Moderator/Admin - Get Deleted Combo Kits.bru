meta {
  name: Admin - Get Deleted Combo Kits
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/combo-kits/admin/deleted?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  List only soft-deleted combo kits. Requires Moderator or Admin.
}
