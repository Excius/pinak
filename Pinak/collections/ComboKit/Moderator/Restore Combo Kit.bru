meta {
  name: Restore Combo Kit
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/combo-kits/{{id}}/restore
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  id: combo-kit-id-here
}

docs {
  Restore a soft-deleted combo kit. Requires Moderator or Admin.
}
