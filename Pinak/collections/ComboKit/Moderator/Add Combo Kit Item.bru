meta {
  name: Add Combo Kit Item
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/combo-kits/{{comboKitId}}/items
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  { "productVariantId": "variant-id-3", "quantity": 1 }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
  comboKitId: combo-kit-id-here
}

docs {
  Add a product variant to an existing combo kit. Requires Moderator or Admin.
}
