meta {
  name: List Related Products
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/products/{{productId}}/related
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
}

docs {
  List related products for a given product (public).
}