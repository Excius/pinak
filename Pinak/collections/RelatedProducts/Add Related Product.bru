meta {
  name: Add Related Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/related
  body: json
  auth: inherit
}

body:json {
  {
    "relatedProductId": "your-related-product-id-here",
    "sortOrder": 1
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  productId: your-product-id-here
  authToken: your-jwt-token-here
}

docs {
  Add a related product link (Moderator/Admin required).
}