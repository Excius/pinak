meta {
  name: Remove Product from Featured
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/products/admin/featured/{{featuredProductId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  featuredProductId: your-featured-product-id-here
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: ProductTypes.RemoveProductFromFeatured
  Route: /products/admin/featured/:featuredProductId
  Params: featuredProductId
  Query: none
  Body: none
}
