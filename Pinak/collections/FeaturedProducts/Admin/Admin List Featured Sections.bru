meta {
  name: Admin List Featured Sections
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/featured-sections/admin/all
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: FeaturedSectionTypes.AdminListFeaturedSections
  Route: /featured-sections/admin/all
  Access: moderator/admin
}
