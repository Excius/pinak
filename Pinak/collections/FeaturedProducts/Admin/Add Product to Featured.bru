meta {
  name: Add Product to Featured
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/products/admin/featured/{{sectionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "productId": "your-product-id-here"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: ProductTypes.AddProductToFeatured
  Route: /products/admin/featured/:sectionId
  Params: sectionId
  Query: none
  Body: productId
}
