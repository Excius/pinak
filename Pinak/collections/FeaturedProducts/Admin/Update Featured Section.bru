meta {
  name: Update Featured Section
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/featured-sections/admin/{{sectionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Homepage Hero Updated",
    "type": "HOMEPAGE_HERO",
    "priority": 20
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  sectionId: your-featured-section-id-here
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: FeaturedSectionTypes.UpdateFeaturedSection
  Route: /featured-sections/admin/:id
  Access: moderator/admin
}
