meta {
  name: Admin Get Featured Section by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/featured-sections/admin/{{sectionId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  sectionId: your-featured-section-id-here
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: FeaturedSectionTypes.AdminGetFeaturedSectionById
  Route: /featured-sections/admin/:id
  Access: moderator/admin
}
