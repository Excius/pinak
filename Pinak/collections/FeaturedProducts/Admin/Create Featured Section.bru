meta {
  name: Create Featured Section
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/featured-sections/admin
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Homepage Hero",
    "type": "HOMEPAGE_HERO",
    "priority": 10
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: FeaturedSectionTypes.CreateFeaturedSection
  Route: /featured-sections/admin
  Access: moderator/admin
}
