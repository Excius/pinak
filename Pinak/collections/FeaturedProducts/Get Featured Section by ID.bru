meta {
  name: Get Featured Section by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/featured-sections/{{sectionId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  sectionId: your-featured-section-id-here
}

docs {
  Fetch a featured section by ID (public).
}
