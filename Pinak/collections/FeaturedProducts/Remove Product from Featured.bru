meta {
  name: Remove Product from Featured
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/v1/featured/{{featuredProductId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  featuredProductId: your-featured-product-id-here
  authToken: your-jwt-token-here
}

docs {
  Remove a product from a featured section (Moderator/Admin required).
}
