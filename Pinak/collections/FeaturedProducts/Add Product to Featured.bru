meta {
  name: Add Product to Featured
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/featured
  body: json
  auth: inherit
}

body:json {
  {
    "sectionId": "your-section-id-here",
    "productId": "your-product-id-here"
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Add a product to a featured section (Moderator/Admin required).
}
