meta {
  name: Delete Featured Section
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/featured-sections/{{sectionId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  sectionId: your-featured-section-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a featured section (Moderator/Admin required).
}
