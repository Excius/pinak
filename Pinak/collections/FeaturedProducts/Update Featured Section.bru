meta {
  name: Update Featured Section
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/featured-sections/{{sectionId}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Homepage Hero Updated",
    "type": "HOMEPAGE_HERO",
    "priority": 20
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  sectionId: your-featured-section-id-here
  authToken: your-jwt-token-here
}

docs {
  Update a featured section (Moderator/Admin required).
}
