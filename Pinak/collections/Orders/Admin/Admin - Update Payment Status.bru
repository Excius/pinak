meta {
  name: Admin - Update Payment Status
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/orders/admin/{{orderId}}/payment
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "paymentStatus": "COMPLETED"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  orderId: use-order-id-from-admin-list-response
}

docs {
  Schema: OrderAdminTypes.UpdatePaymentStatus
}
