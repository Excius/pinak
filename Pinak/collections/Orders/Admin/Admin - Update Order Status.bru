meta {
  name: Admin - Update Order Status
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/orders/admin/{{orderId}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "status": "SHIPPED"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  orderId: use-order-id-from-admin-list-response
}

docs {
  Schema: OrderAdminTypes.UpdateOrderStatus
}
