meta {
  name: Admin - List Orders
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/orders/admin?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  ~status: PROCESSING
  ~paymentStatus: COMPLETED
  ~userId: user-id
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: OrderAdminTypes.ListOrders
}
