meta {
  name: Get My Orders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders?page=1&limit=10
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  ~status: CANCELLED
  ~paymentStatus: PENDING
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: OrderTypes.GetOrders
}
