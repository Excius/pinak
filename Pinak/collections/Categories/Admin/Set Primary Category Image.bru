meta {
  name: Set Primary Category Image
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/categories/admin/images/{{imageId}}/primary
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  imageId: your-image-id-here
  authToken: your-jwt-token-here
}

docs {
  Set an image as primary for its category (admin only).
}
