meta {
  name: Update Category
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/categories/admin/{{categoryId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Sample Category Updated",
    "slug": "sample-category-updated",
    "parentId": null
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  categoryId: your-category-id-here
  authToken: your-jwt-token-here
}

docs {
  Update category (Moderator/Admin required).
}
