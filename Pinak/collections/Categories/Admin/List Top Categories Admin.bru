meta {
  name: List Top Categories (Admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/categories/admin/top
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  List top-level categories (admin — full content with images).
}
