meta {
  name: Add Category Image
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/categories/admin/{{categoryId}}/images
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "url": "https://example.com/images/categories/sample.jpg",
    "altText": "Sample category image",
    "isPrimary": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  categoryId: your-category-id-here
  authToken: your-jwt-token-here
}

docs {
  Add an image to a category (admin only). Body: `url`, optional `altText`, optional `isPrimary`.
}
