meta {
  name: Soft Delete Category Image
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/categories/admin/images/{{id}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  id: your-image-id-here
  authToken: your-jwt-token-here
}

docs {
  Soft-delete a category image (admin only).
}
