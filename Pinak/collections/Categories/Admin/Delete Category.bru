meta {
  name: Delete Category
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/categories/admin/{{categoryId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  categoryId: your-category-id-here
  authToken: your-jwt-token-here
}

docs {
  Delete a category (Moderator/Admin required).
}
