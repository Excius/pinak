meta {
  name: Get Category by Slug
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/categories/slug/{{slug}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  slug: foundation
  authToken: your-jwt-token-here
}

docs {
  Fetch a category by its SEO slug.
  
  Path Parameters:
  - slug: category slug (required)
}
