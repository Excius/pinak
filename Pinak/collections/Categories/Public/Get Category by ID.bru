meta {
  name: Get Category by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/categories/{{categoryId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  categoryId: cmnj36dak001f2amzsu5z2a4b
  authToken: your-jwt-token-here
}

docs {
  Fetch a category by its ID.
  
  Path Parameters:
  - categoryId: Category ID (required)
}
