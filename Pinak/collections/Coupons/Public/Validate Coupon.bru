meta {
  name: Validate Coupon
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/coupons/validate
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "code": "WELCOME10",
    "cartTotal": 5800
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-jwt-token-here
}

docs {
  Schema: CouponTypes.ValidateCoupon
  Requires authenticated user.
}
