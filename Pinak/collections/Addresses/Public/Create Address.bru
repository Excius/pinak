meta {
  name: Create Address
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/addresses
  body: json
  auth: inherit
}

body:json {
  {
    "fullName": "John Doe",
    "addressLine1": "123 Main St",
    "addressLine2": "Apt 4B",
    "city": "Springfield",
    "state": "IL",
    "pincode": "627040",
    "phone": "1234567890",
    "label": "Home",
    "isDefault": true
  }
}
