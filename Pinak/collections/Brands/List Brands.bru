meta {
  name: List Brands
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/brands?activeOnly={{activeOnly}}
  body: none
  auth: inherit
}

params:query {
  activeOnly: true
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  activeOnly: true
}

docs {
  List brands (authenticated). Use `activeOnly` to return only active brands.
}
