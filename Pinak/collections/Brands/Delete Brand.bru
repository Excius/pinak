meta {
  name: Delete Brand
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  brandId: your-brand-id-here
}

docs {
  Delete a brand (Moderator/Admin required). Ensure there are no dependent products before deleting.
}
