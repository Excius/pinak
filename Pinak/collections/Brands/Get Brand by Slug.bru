meta {
  name: Get Brand by Slug
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/brands/slug/{{slug}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  baseUrl: http://localhost:3000
  slug: nike
}

docs {
  Fetch a brand by its slug (authenticated).
}
