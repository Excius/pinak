meta {
  name: Get Brand by ID (Admin)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/brands/admin/{{brandId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  brandId: your-brand-id-here
}

docs {
  Schema: BrandAdminTypes.GetBrandById
  Params: brandId
  Query: none
  Body: none
}
