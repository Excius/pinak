meta {
  name: List Brands Admin
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/brands/admin?activeOnly={{activeOnly}}
  body: none
  auth: inherit
}

params:query {
  activeOnly: true
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  activeOnly: true
}

docs {
  Schema: BrandAdminTypes.ListBrands
  Params: none
  Query: activeOnly
  Body: none
}
