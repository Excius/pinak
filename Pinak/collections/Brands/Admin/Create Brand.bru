meta {
  name: Create Brand
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/brands/admin
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Nivea",
    "slug": "nivea",
    "logoUrl": "https://example.com/logo.png",
    "isActive": true
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
}

docs {
  Schema: BrandTypes.CreateBrand
  Params: none
  Query: none
  Body: name(required), slug, logoUrl, isActive
}
