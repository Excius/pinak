meta {
  name: Update Brand
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/brands/admin/{{brandId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Nivea Updated",
    "slug": "nivea-updated",
    "logoUrl": "https://example.com/logo-updated.png",
    "isActive": false
  }
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  brandId: your-brand-id-here
}

docs {
  Schema: BrandTypes.UpdateBrand
  Params: brandId
  Query: none
  Body: name, slug, logoUrl, isActive
}
