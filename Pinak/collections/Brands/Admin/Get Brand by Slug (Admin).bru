meta {
  name: Get Brand by Slug (Admin)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/brands/admin/slug/{{slug}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  authToken: your-moderator-or-admin-jwt-token-here
  slug: nivea
}

docs {
  Schema: BrandAdminTypes.GetBrandBySlug
  Params: slug
  Query: none
  Body: none
}
