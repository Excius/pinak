meta {
  name: Get Brand by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
  brandId: your-brand-id-here
}

docs {
  Fetch a brand by ID (authenticated).
}
