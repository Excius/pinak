{
  "name": "pinak",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=api",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:studio": "turbo run prisma:studio",
    "setup:backend": "npm install --dev && npm run build:packages && cd apps/api && npx prisma generate",
    "start:backend": "cd apps/api && npm run start"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "^4.7.0",
    "turbo": "^2.9.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "react-native-toast-message": "^2.3.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.27.7": true,
    "prisma@7.8.0": true,
    "unrs-resolver@1.11.1": true
  }
}
