{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "prisma/schema.prisma"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "NODE_ENV",
        "LOG_LEVEL",
        "DATABASE_URL",
        "REDIS_URL",
        "CORS_ORIGIN",
        "CORS_ORIGINS",
        "JWT_SECRET",
        "REFRESH_TOKEN_EXPIRY",
        "ACCESS_TOKEN_EXPIRY",
        "MAIL_FROM",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_SECURE",
        "FORGOT_PASSWORD_EXPIRY_MINUTES",
        "EMAIL_VERIFICATION_EXPIRY_HOURS",
        "BACKEND_URL",
        "FRONTEND_URL",
        "MOBILE_APP_URL",
        "RATE_LIMIT_WINDOW_MINUTES",
        "RATE_LIMIT_MAX",
        "AUTH_RATE_LIMIT_MAX",
        "CLIENT_ID_WEB",
        "CLIENT_ID_MOBILE",
        "CLIENT_SECRET",
        "REDIRECT_URI_WEB",
        "REDIRECT_URI_MOBILE",
        "REDIRECT_URI_BACKEND",
        "S3_ENABLED",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "S3_SIGNED_URL_EXPIRES"
      ]
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
